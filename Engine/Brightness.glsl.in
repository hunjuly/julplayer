//!HOOK OUTPUT
//!BIND HOOKED
//!DESC Video brightness

vec3 pqBrightness(vec3 rgb, float gain) {
    // ST 2084 encodes absolute light. Apply gain between its inverse and forward curves.
    const float m1 = 2610.0 / 16384.0;
    const float m2 = 2523.0 / 32.0;
    const float c1 = 3424.0 / 4096.0;
    const float c2 = 2413.0 / 128.0;
    const float c3 = 2392.0 / 128.0;
    vec3 signal = pow(clamp(rgb, 0.0, 1.0), vec3(1.0 / m2));
    vec3 lightToM1 = max(signal - c1, 0.0) / (c2 - c3 * signal);
    lightToM1 = min(lightToM1 * pow(gain, m1), 1.0);
    return pow((c1 + c2 * lightToM1) / (1.0 + c3 * lightToM1), vec3(m2));
}

vec3 srgbBrightness(vec3 rgb, float gain) {
    rgb = clamp(rgb, 0.0, 1.0);
    vec3 light = mix(pow((rgb + 0.055) / 1.055, vec3(2.4)), rgb / 12.92,
                     lessThanEqual(rgb, vec3(0.04045)));
    // Keep the requested gain in shadows and midtones. Roll highlights smoothly up to SDR white.
    const float knee = 0.8;
    float peak = max(light.r, max(light.g, light.b));
    float excess = gain * peak - knee;
    if (excess > 0.0) {
        float shoulder = 1.0 + excess * (1.0 / (1.0 - knee) - 1.0 / (gain - knee));
        gain = (knee + excess / shoulder) / peak;
    }
    light *= gain;
    return mix(1.055 * pow(light, vec3(1.0 / 2.4)) - 0.055, 12.92 * light,
               lessThanEqual(light, vec3(0.0031308)));
}

vec4 hook() {
    vec4 pixel = HOOKED_tex(HOOKED_pos);
    pixel.rgb = @transfer@Brightness(pixel.rgb, @gain@);
    return pixel;
}
